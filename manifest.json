{
  "manifest_version": 3,
  "name": "RTLify for Claude — Arabic, Persian & RTL Text Fix",
  "version": "1.0.4",
  "description": "Fix Arabic, Persian, Urdu & right-to-left (RTL) text in Claude AI. Open-source, 100% local, no tracking, no data.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RTLify for Claude",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claude.site/*",
        "https://*.claude.site/*"
      ],
      "js": ["src/constants.js", "src/detect.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
